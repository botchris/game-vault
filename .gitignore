# Runtime data: the database (game keys, store sessions, cookies, API keys), downloaded images,
# logs and backups. Back it up, never commit it. Everything in it is ignored; only the empty
# folder is published, through its .gitkeep.
/config/*
!/config/.gitkeep

# Second safety net: personal databases anywhere in the tree (test copies, backups such as
# gamevault-20261007-141943.db, exports…).
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.zip

# Secrets that might be dropped next to the code
.env
.env.*
*.pem
*.key

# Build output
/bin/
/web/dist/
/web/node_modules/
/extension/tests/e2e/node_modules/
/web/tsconfig.tsbuildinfo

# Personal Claude Code settings (the shared ones are .claude/settings.json)
/.claude/settings.local.json

# OS and editor files
.DS_Store
*.swp
.idea/
.vscode/

# Agent work files (plan ledgers, review packages)
/.superpowers/
dist/
